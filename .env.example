DATABASE_URL="postgresql://simple_games:simple_games@127.0.0.1:5432/simple_games?schema=public"
API_PORT=3000
HOST=127.0.0.1
# auto: use the running database; otherwise start Compose for the URL above.
# external: use your existing PostgreSQL service, never start Docker.
# On the current Windows machine PostgreSQL uses port 5435 (see docs/backend-guide.md).
DB_MODE=auto

{
  "name": "simple-games",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "start:local": "ng serve --host 127.0.0.1 --port 4200",
    "start:api": "node dist/api/main.js",
    "dev:api": "npm run build:api && npm run start:api",
    "build": "ng build",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "vitest run"
  },
  "dependencies": {
    "@angular/common": "21.2.12",
    "@angular/compiler": "21.2.12",
    "@angular/core": "21.2.12",
    "@angular/platform-browser": "21.2.12",
    "@angular/router": "21.2.12",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.10",
    "@angular/cli": "21.2.10",
    "@angular/compiler-cli": "21.2.12",
    "@nestjs/testing": "^11.1.28",
    "@types/node": "^26.1.1",
    "prisma": "^7.8.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8"
  }
}

{
  "name": "simple-games",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.14.0",
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "start": "npm run env:ensure && ng serve --host 0.0.0.0 --port 4200",
    "start:local": "npm run env:ensure && ng serve --host 127.0.0.1 --port 4200",
    "start:api": "node dist/api/main.js",
    "dev": "npm run dev:setup && node scripts/dev.mjs",
    "dev:full": "npm run dev",
    "dev:setup": "npm run db:start && npm run db:push",
    "dev:api": "nodemon",
    "env:ensure": "node scripts/ensure-env.mjs",
    "db:start": "npm run env:ensure && node scripts/database.mjs start",
    "db:stop": "node scripts/database.mjs stop",
    "db:reset": "node scripts/database.mjs reset",
    "db:wait": "node scripts/wait-for-db.mjs",
    "db:push": "prisma db push && prisma generate",
    "db:studio": "npm run db:start && prisma studio --port 5555",
    "build": "ng build",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev && prisma generate",
    "test": "vitest run",
    "dev:backend": "npm run dev:setup && npm run dev:api",
    "dev:studio": "prisma studio --port 5555 --browser none",
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "dev:open": "node scripts/dev-open.mjs",
    "api:open": "node scripts/dev-open.mjs api",
    "db:status": "node scripts/database.mjs status",
    "db:logs": "node scripts/database.mjs logs",
    "check": "npm run prisma:generate && npm run build:api && npm run build"
  },
  "dependencies": {
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/platform-browser": "22.1.5",
    "@angular/router": "22.1.5",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.5",
    "@nestjs/testing": "^11.1.28",
    "@types/node": "^26.1.1",
    "concurrently": "^9.2.4",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  }
}
